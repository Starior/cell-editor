<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CellEditorApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <PackageReference Include="Pfim" Version="0.11.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Launcher.cs" />
  </ItemGroup>

  <Target Name="WrapForModOrganizer" AfterTargets="Build">
    <Exec Command="&quot;C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /t:winexe /r:System.Management.dll /r:System.Windows.Forms.dll /out:&quot;$(OutputPath)CellEditor.exe&quot; &quot;$(ProjectDir)Launcher.cs&quot;" />
  </Target>

</Project>
