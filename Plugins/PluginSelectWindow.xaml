<Window x:Class="CellEditor.Plugins.PluginSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Plugins" Height="740" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="#FF252526" Foreground="#FFD4D4D4">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Plugins enabled in MO2 are checked. Checking a plugin also checks its masters." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="None" Width="88" Margin="0,0,8,0" Click="None_Click" />
                <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
                <Button Content="Cancel" Width="88" IsCancel="True" />
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FilterBox" TextChanged="Filter_Changed"
                     Background="#FF1E1E1E" Foreground="#FFD4D4D4" CaretBrush="#FFD4D4D4"
                     BorderBrush="#FF3F3F3F" BorderThickness="1" />
        </DockPanel>
        <ListBox x:Name="PluginList" VirtualizingPanel.IsVirtualizing="True"
                 Background="#FF252526" Foreground="#FFD4D4D4"
                 BorderBrush="#FF3F3F3F" BorderThickness="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFD4D4D4" />
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF3E3E42" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF094771" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsEnabled="{Binding CanCheck}" ToolTip="{Binding MastersText}"
                              Foreground="#FFD4D4D4">
                        <TextBlock Text="{Binding Label}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFD4D4D4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanCheck}" Value="False">
                                            <Setter Property="Foreground" Value="#FF8A8A8A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
