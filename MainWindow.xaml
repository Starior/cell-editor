<Window x:Class="CellEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:cells="clr-namespace:CellEditor.Cells"
        mc:Ignorable="d"
        Title="Cell Editor" Height="800" Width="1200"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFD4D4D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3E3E42" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF094771" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Cell..." Click="OpenCell_Click" />
                <MenuItem Header="_Open NIF..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Plugins..." Click="Plugins_Click" />
                <Separator />
                <MenuItem x:Name="PatchMenuItem" Header="Create _patch..." Click="CreatePatch_Click" IsEnabled="False"
                          InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="TexturesMenuItem" Header="_Textures" IsCheckable="True" IsChecked="True"
                          Checked="TexturesMenu_Checked" Unchecked="TexturesMenu_Unchecked" />
                <MenuItem x:Name="NormalMapsMenuItem" Header="_Normal maps" IsCheckable="True" IsChecked="True"
                          Click="NormalMapsMenu_Click" />
                <MenuItem x:Name="OcclusionMenuItem" Header="Ambient _occlusion" IsCheckable="True" IsChecked="True"
                          Click="OcclusionMenu_Click" />
                <MenuItem x:Name="MarkersMenuItem" Header="_Markers" IsCheckable="True" IsChecked="False"
                          Checked="MarkersMenu_Checked" Unchecked="MarkersMenu_Unchecked" />
                <MenuItem x:Name="LogsMenuItem" Header="_Logs" IsCheckable="True" IsChecked="True"
                          Checked="LogsMenu_Checked" Unchecked="LogsMenu_Unchecked" />
                <Separator />
                <MenuItem Header="Reload _categories" Click="ReloadCategories_Click" />
                <MenuItem Header="Open categories._json" Click="OpenCategories_Click" />
                <Separator />
                <MenuItem Header="Delete unused mesh cache" Click="DeleteMeshCache_Click" />
            </MenuItem>
        </Menu>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition x:Name="LogSplitterRow" Height="4" />
            <RowDefinition x:Name="LogRow" Height="180" MinHeight="0" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="LogPanel" Grid.Row="2" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#FF333333" Padding="8,4">
                <DockPanel>
                    <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="CopyLogs_Click" ToolTip="Copy logs"
                            Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="#FFD4D4D4" />
                    </Button>
                    <TextBlock Text="Logs" VerticalAlignment="Center" Foreground="#FFD4D4D4" />
                </DockPanel>
            </Border>
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     BorderThickness="0"
                     Background="#FF1E1E1E"
                     Foreground="#FFD4D4D4"
                     CaretBrush="#FFD4D4D4"
                     FontFamily="Consolas"
                     FontSize="13"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </DockPanel>
        <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#FF3F3F3F" />

        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="460" MinWidth="160" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition x:Name="PropertiesSplitterColumn" Width="0" />
            <ColumnDefinition x:Name="PropertiesColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#FF3F3F3F" />
        <GridSplitter x:Name="PropertiesSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#FF3F3F3F" Visibility="Collapsed" />

        <Border x:Name="PropertiesPanel" Grid.Column="4" Background="#FF252526" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <DockPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="CloseProperties_Click" ToolTip="Deselect and close"
                            Background="Transparent" BorderThickness="0" Padding="4,0" Margin="6,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="13" Foreground="#FFD4D4D4" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="CopyObject_Click" ToolTip="Copy coordinates, model, and texture paths"
                            Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="#FFD4D4D4" />
                    </Button>
                    <Button x:Name="ResetObjectButton" Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="ResetObject_Click" IsEnabled="False"
                            ToolTip="Reset position, angles, model, plugin, and texture mod"
                            Background="Transparent" BorderThickness="0" Padding="4,0" Margin="0,0,6,0" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFD4D4D4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                            <Setter Property="Foreground" Value="#FF5A5A5A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <TextBlock Text="Object" Foreground="#FFD4D4D4" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="PropForm" Foreground="#FFD4D4D4" TextWrapping="Wrap" Cursor="Hand"
                           ToolTip="Click to copy the reference form, base form, and name"
                           MouseLeftButtonUp="PropForm_Click" />
                <TextBlock x:Name="PropName" Foreground="#FFD4D4D4" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="PropPlugin" Foreground="#FF8A8A8A" TextWrapping="Wrap" Margin="0,4,0,0" />
                <CheckBox x:Name="DisabledToggle" Content="Disabled" Foreground="#FFD4D4D4" Margin="0,6,0,0"
                          ToolTip="Saved to the patch as Initially Disabled, enable parent = player (opposite)"
                          Click="DisabledToggle_Click" />
                <TextBox x:Name="PropModel" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" Margin="0,4,0,8"
                         Background="Transparent" BorderThickness="0" Padding="0" Foreground="#FFD4D4D4"
                         SelectionBrush="#FF264F78" ToolTip="Select to copy all or part of the path" />
                <TextBlock Text="Swap model" Foreground="#FFD4D4D4" Margin="0,0,0,2" />
                <TextBox x:Name="ModelSearch" Padding="4,2" FontFamily="Consolas"
                         Background="#FF1E1E1E" Foreground="#FFD4D4D4" BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                         ToolTip="Editor id, name, form id, or mesh path"
                         TextChanged="ModelSearch_Changed" PreviewKeyDown="ModelSearch_KeyDown" />
                <ListBox x:Name="ModelResults" MaxHeight="200" Visibility="Collapsed" Margin="0,2,0,0"
                         Background="#FF1E1E1E" Foreground="#FFD4D4D4" BorderBrush="#FF3F3F3F"
                         FontSize="11" DisplayMemberPath="Label"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="ModelResults_MouseUp" KeyDown="ModelResults_KeyDown" />
                <TextBlock x:Name="PropSwap" Foreground="#FFE0B060" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                <TextBlock Text="Position" Foreground="#FFD4D4D4" Margin="0,8,0,2" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="X" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="PosX" Grid.Row="0" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                    <TextBlock Grid.Row="1" Text="Y" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="PosY" Grid.Row="1" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                    <TextBlock Grid.Row="2" Text="Z" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="PosZ" Grid.Row="2" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                </Grid>
                <TextBlock x:Name="PropScale" Foreground="#FFD4D4D4" FontFamily="Consolas" Margin="0,4,0,0" Visibility="Collapsed" />
                <TextBlock Text="Angle" Foreground="#FFD4D4D4" Margin="0,8,0,2" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="X" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="AngX" Grid.Row="0" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                    <TextBlock Grid.Row="1" Text="Y" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="AngY" Grid.Row="1" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                    <TextBlock Grid.Row="2" Text="Z" Foreground="#FFD4D4D4" VerticalAlignment="Center" />
                    <TextBox x:Name="AngZ" Grid.Row="2" Grid.Column="1" Margin="0,1" Padding="4,2"
                             FontFamily="Consolas" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
                             BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                             TextChanged="Position_Changed" LostFocus="Position_LostFocus" />
                </Grid>
                <TextBlock Text="Plugin" Foreground="#FFD4D4D4" Margin="0,8,0,4" />
                <ComboBox x:Name="VersionBox" DisplayMemberPath="Label" SelectionChanged="Version_Changed" Margin="0,0,0,8" />
                <CheckBox x:Name="TextureToggle" Content="Textures" IsChecked="True" Foreground="#FFD4D4D4"
                          Checked="TextureToggle_Changed" Unchecked="TextureToggle_Changed" />
                <TextBlock Text="Texture mod" Foreground="#FFD4D4D4" Margin="0,12,0,4" />
                <ComboBox x:Name="TextureMod" SelectionChanged="TextureMod_Changed" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="0" Background="#FF252526">
            <DockPanel>
                <TextBox x:Name="ObjectSearch" DockPanel.Dock="Top" Margin="8,8,8,0" Padding="6,4"
                         Background="#FF1E1E1E" Foreground="#FFD4D4D4" BorderBrush="#FF3F3F3F" CaretBrush="#FFD4D4D4"
                         FontFamily="Consolas" ToolTip="Form ID" TextChanged="ObjectSearch_Changed" />
                <DockPanel x:Name="CategoryBar" DockPanel.Dock="Top" Margin="8,6,8,0" Visibility="Collapsed">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6,2" VerticalAlignment="Top"
                            Click="CategoryAll_Click" ToolTip="Show every category">
                        <TextBlock Text="All" FontSize="11" />
                    </Button>
                    <ItemsControl x:Name="CategoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" Click="CategoryFilter_Click"
                                          MouseRightButtonUp="CategoryOnly_RightClick" Margin="0,0,10,3"
                                          ToolTip="Click: show or hide. Right-click: show only this category." Foreground="#FFD4D4D4">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,6,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Form ID" Foreground="#FF8A8A8A" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0" />
                    <TextBlock Grid.Column="1" Text="Name" Foreground="#FF8A8A8A" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="RevealHiddenButton" Grid.Column="2" Style="{StaticResource IconButton}" Padding="6,1"
                            Visibility="Hidden" Click="RevealHidden_Click" ToolTip="Show all objects hidden with the eye button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE890;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Show hidden" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TreeView x:Name="ObjectTree" Background="#FF252526" Foreground="#FFD4D4D4" BorderThickness="0"
                          SelectedItemChanged="Objects_Selected" Margin="0,4,0,0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type cells:PluginNode}" ItemsSource="{Binding Objects}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanDisable}"
                                          Click="PluginToggle_Click" VerticalAlignment="Center" Margin="0,0,6,0"
                                          ToolTip="Unchecking also unchecks plugins that use this one as a master. The cell's own plugin and its masters stay on." />
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFD4D4D4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF777777" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type cells:SceneObject}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Width="3" Height="12" HorizontalAlignment="Left"
                                           Fill="{Binding CategoryColor}" ToolTip="{Binding Category}" />
                                <TextBlock Grid.Column="0" Text="{Binding Mesh.FormId}" ToolTip="{Binding Category}" Margin="7,0,0,0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFD4D4D4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShownDisabled}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF777777" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF9A9A9A" />
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Mesh.BaseName}" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FFD4D4D4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShownDisabled}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF777777" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF9A9A9A" />
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="4,0" Margin="4,0,0,0"
                                        PreviewMouseLeftButtonDown="ObjectVisibility_PreviewDown"
                                        ToolTip="Hide or show in viewport" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE890;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Text" Value="&#xED1A;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#FFD4D4D4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <EventSetter Event="Selected" Handler="TreeItem_Selected" />
                            <EventSetter Event="MouseDoubleClick" Handler="TreeItem_DoubleClick" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    <Setter Property="Background" Value="#FF094771" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <hx:Viewport3DX x:Name="Viewport" BackgroundColor="#FF2B2B2B" ShowCoordinateSystem="True"
                            Focusable="True" FXAALevel="Medium"
                            EnableSSAO="True" SSAOSamplingRadius="24" SSAOIntensity="1.2"
                            PreviewMouseLeftButtonDown="Viewport_Down" PreviewMouseLeftButtonUp="Viewport_Up"
                            CameraChanged="Viewport_CameraChanged">
                <hx:AmbientLight3D Color="#FF7A7A7A" />
                <hx:DirectionalLight3D x:Name="HeadLight" Direction="0,-0.2,-1" Color="#FFF2EEE6" />
                <hx:DirectionalLight3D x:Name="FillLight" Direction="0,0.3,0.8" Color="#FF6A6E78" />
                <hx:DirectionalLight3D Direction="0.3,-1,0.2" Color="#FF5A5650" />
            </hx:Viewport3DX>

            <Grid VerticalAlignment="Top" Margin="8" Panel.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Camera" Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CameraModeBox" Width="88" SelectedIndex="0" SelectionChanged="CameraMode_Changed">
                        <ComboBoxItem Content="Orbit" />
                        <ComboBoxItem Content="Fly" />
                    </ComboBox>
                    <TextBlock Text="Speed" Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <Slider x:Name="FlySpeedSlider" Width="120" Minimum="40" Maximum="800" Value="220"
                            VerticalAlignment="Center" ValueChanged="FlySpeed_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ClipToggle" Content="Clip" Foreground="#FFD4D4D4" VerticalAlignment="Center"
                              Margin="0,0,8,0" Checked="Clip_Changed" Unchecked="Clip_Changed" />
                    <Slider x:Name="ClipSlider" Width="100" Minimum="1" Maximum="400" Value="40" IsEnabled="False"
                            VerticalAlignment="Center" ValueChanged="Clip_Changed" />
                </StackPanel>
            </Grid>

            <Border x:Name="BusyCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#E6252526" BorderBrush="#FF3F3F3F" BorderThickness="1" Padding="18,14" Panel.ZIndex="20">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Loading meshes" Foreground="#FFD4D4D4" FontSize="16" />
                    <TextBlock x:Name="BusyDetail" Foreground="#FFAAAAAA" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
